<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="GameStyles.uss" />

    <ui:VisualElement name="MainMenuScreen" class="full-screen">
        <ui:Label text="Dungeon Girls" class="title-label" />
        <ui:Button name="StartRunButton" text="Начать забег" class="button-primary" />
        <ui:Button name="BuildingsButton" text="Здания" class="button-secondary" />
        <ui:Button name="GachaButton" text="Гача" class="button-secondary" />
        <ui:Button name="ResetProgressButton" text="Сбросить прогресс" class="button-secondary" />
        <ui:VisualElement name="ResetProgressConfirmPopup" class="panel hidden" style="max-width: 400px; flex-grow: 0;">
            <ui:Label text="Сбросить прогресс?" class="panel-title" />
            <ui:Label text="Действие необратимо: мета-валюта, гача-валюта, уровни зданий и гача-копии будут удалены." class="body-label" />
            <ui:VisualElement style="flex-direction: row;">
                <ui:Button name="ResetProgressConfirmButton" text="Да, сбросить" class="button-primary" />
                <ui:Button name="ResetProgressCancelButton" text="Отмена" class="button-secondary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="BuildingsScreen" class="full-screen hidden" style="flex-direction: column;">
        <ui:Label text="Здания деревни" class="title-label" />
        <ui:Label name="MetaCurrencyLabel" text="Мета-валюта: 0" class="currency-label" />
        <ui:VisualElement class="buildings-row">
            <ui:VisualElement name="ForgeCard" class="building-card">
                <ui:Label text="Кузница" class="building-card-title" />
                <ui:Label name="ForgeLevelLabel" text="" class="body-label" />
                <ui:Label name="ForgeBonusLabel" text="" class="body-label" />
                <ui:Label name="ForgeCostLabel" text="" class="body-label" />
                <ui:Button name="ForgeUpgradeButton" text="Улучшить" class="button-primary" />
            </ui:VisualElement>
            <ui:VisualElement name="TempleCard" class="building-card">
                <ui:Label text="Храм" class="building-card-title" />
                <ui:Label name="TempleLevelLabel" text="" class="body-label" />
                <ui:Label name="TempleBonusLabel" text="" class="body-label" />
                <ui:Label name="TempleCostLabel" text="" class="body-label" />
                <ui:Button name="TempleUpgradeButton" text="Улучшить" class="button-primary" />
            </ui:VisualElement>
            <ui:VisualElement name="TavernCard" class="building-card">
                <ui:Label text="Таверна" class="building-card-title" />
                <ui:Label name="TavernLevelLabel" text="" class="body-label" />
                <ui:Label name="TavernBonusLabel" text="" class="body-label" />
                <ui:Label name="TavernCostLabel" text="" class="body-label" />
                <ui:Button name="TavernUpgradeButton" text="Улучшить" class="button-primary" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="BuildingsBackButton" text="Назад" class="button-secondary" />
    </ui:VisualElement>

    <ui:VisualElement name="GachaScreen" class="full-screen hidden" style="flex-direction: column;">
        <ui:Label text="Гача" class="title-label" />
        <ui:Label name="GachaCurrencyLabel" text="Гача-валюта: 0" class="currency-label" />
        <ui:Button name="GachaPullButton" text="Призыв (50 гача-валюты)" class="button-primary" />
        <ui:VisualElement name="GachaResultPopup" class="panel hidden" style="max-width: 400px; flex-grow: 0;">
            <ui:Label text="Результат призыва" class="panel-title" />
            <ui:Label name="GachaResultLabel" text="" class="body-label" />
            <ui:Button name="GachaResultCloseButton" text="Ок" class="button-secondary" />
        </ui:VisualElement>
        <ui:Button name="GachaBackButton" text="Назад" class="button-secondary" />
    </ui:VisualElement>

    <ui:VisualElement name="RunScreen" class="run-root hidden">
        <ui:VisualElement name="TopBar" class="top-bar">
            <ui:Label name="FloorLabel" text="Этаж 1/10" class="top-bar-label" />
            <ui:VisualElement name="RoomProgressContainer" class="room-progress-row" />
            <ui:Label name="RationsLabel" text="Рационы: 5" class="top-bar-label" />
        </ui:VisualElement>

        <ui:VisualElement name="MainRow" class="main-row">
        <ui:VisualElement name="ContentArea" class="content-area">

            <ui:VisualElement name="CombatPanel" class="panel hidden">
                <!-- src="project://database/..." does not resolve at runtime (confirmed via PlayModeSmokeTest);
                     sprite is assigned in code by RunFlowController.combatBackgroundSprite instead. -->
                <ui:Image name="CombatBackground" class="combat-background" scale-mode="ScaleAndCrop" />
                <ui:Label text="Бой" class="panel-title" />
                <ui:VisualElement class="combat-top-row">
                    <ui:VisualElement name="PlayerBox" class="combatant-box">
                        <ui:Image name="PlayerPortraitImage" class="combatant-portrait" scale-mode="ScaleToFit" />
                        <ui:Label name="PlayerNameLabel" text="Дженифер" class="combatant-name" />
                        <ui:VisualElement class="hp-bar-bg">
                            <ui:VisualElement name="PlayerHpFill" class="hp-bar-fill hp-bar-fill-player" style="width: 100%;" />
                        </ui:VisualElement>
                        <ui:Label name="PlayerHpText" text="20/20" class="hp-text" />
                        <ui:Label name="PlayerDefenseText" text="Защита: 0" class="stat-text" />
                        <ui:Label name="PlayerShieldText" text="Щит: 0" class="stat-text" />
                    </ui:VisualElement>
                    <ui:VisualElement name="EnemyListContainer" class="enemy-list" />
                </ui:VisualElement>

                <ui:VisualElement class="combat-controls-row">
                    <ui:Toggle name="AutoModeToggle" label="Авто-режим навыка" value="true" />
                    <ui:Button name="ActiveSkillButton" text="Активный навык" class="button-secondary" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="EventPopup" class="panel hidden">
                <ui:Label text="Событие" class="panel-title" />
                <ui:Label name="EventDescriptionLabel" text="" class="body-label" />
                <ui:VisualElement name="EventChoicesContainer" />
            </ui:VisualElement>

            <ui:VisualElement name="TrapPopup" class="panel hidden">
                <ui:Label name="TrapPopupTitle" text="Ловушка" class="panel-title" />
                <ui:Label name="TrapDescriptionLabel" text="" class="body-label" />
                <ui:Label name="TrapChanceLabel" text="Шанс успеха: 50%" class="body-label" />
                <ui:VisualElement name="TrapChoiceRow" style="flex-direction: row;">
                    <ui:Button name="TrapAttemptButton" text="Попытаться пройти ловушку" class="button-primary" />
                    <ui:Button name="TrapSkipButton" text="Пойти дальше" class="button-secondary" />
                </ui:VisualElement>
                <ui:Label name="TrapOutcomeLabel" text="" class="body-label hidden" />
                <ui:Button name="TrapContinueButton" text="Продолжить" class="button-primary hidden" />
            </ui:VisualElement>

            <ui:VisualElement name="LevelUpPanel" class="panel hidden">
                <ui:Label text="Выберите навык" class="panel-title" />
                <ui:VisualElement name="LevelUpCardsContainer" />
            </ui:VisualElement>

            <ui:VisualElement name="CampPanel" class="panel hidden">
                <ui:Label text="Привал" class="panel-title" />
                <ui:Label name="CampText" text="Дженифер отдыхает..." class="body-label" />
                <ui:Button name="CampAcceptButton" text="Встать на привал" class="button-primary" />
                <ui:Button name="CampDeclineButton" text="Идти дальше" class="button-secondary" />
                <ui:Button name="CampContinueButton" text="Продолжить" class="button-primary" />
            </ui:VisualElement>

            <ui:VisualElement name="MerchantPanel" class="panel hidden">
                <ui:Label text="Торговец" class="panel-title" />
                <ui:Label name="MerchantCurrencyLabel" text="Валюта забега: 0" class="body-label" />
                <ui:VisualElement name="MerchantOffersContainer" class="merchant-offers-row" />
                <ui:Button name="MerchantContinueButton" text="Уйти от торговца" class="button-primary" />
            </ui:VisualElement>

            <ui:VisualElement name="RewardPanel" class="panel hidden">
                <ui:Label text="Награда" class="panel-title" />

                <ui:VisualElement name="ChestRevealContainer" class="chest-reveal-container">
                    <ui:Image name="ChestSpriteImage" class="chest-sprite" />
                    <ui:VisualElement name="ChestReelViewport" class="chest-reel-viewport">
                        <ui:VisualElement name="ChestReelStrip" class="chest-reel-strip" />
                    </ui:VisualElement>
                    <ui:Button name="ChestSkipButton" text="Пропустить" class="button-secondary" />
                </ui:VisualElement>

                <ui:Label name="RewardText" text="" class="body-label" />
                <ui:Button name="RewardContinueButton" text="Продолжить" class="button-primary" />
            </ui:VisualElement>

            <ui:VisualElement name="ItemComparePanel" class="panel hidden">
                <ui:Label text="Новый предмет" class="panel-title" />
                <ui:VisualElement name="NewItemCard" class="item-card">
                    <ui:Label text="Новый" class="item-card-header" />
                    <ui:Label name="NewItemName" text="" class="item-card-name" />
                    <ui:Label name="NewItemStats" text="" class="body-label" />
                </ui:VisualElement>
                <ui:Label text="Выберите, какой слот занять:" class="body-label" />
                <ui:VisualElement name="SlotChoicesContainer" class="item-compare-row" />
                <ui:Button name="ItemDiscardButton" text="Выбросить новый предмет" class="button-secondary" />
            </ui:VisualElement>

        </ui:VisualElement>

        <ui:VisualElement name="RunLogPanel" class="run-log-panel">
            <ui:Label text="Журнал забега" class="panel-title" />
            <ui:ScrollView name="RunLogScroll" class="combat-log-scroll">
                <ui:Label name="RunLogText" text="" class="combat-log-text" />
            </ui:ScrollView>
        </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="ResultsScreen" class="full-screen hidden" style="flex-direction: column;">
        <ui:Label name="ResultsTitleLabel" text="Победа" class="results-victory" />
        <ui:Label name="ResultsBodyLabel" text="" class="body-label" style="max-width: 500px; -unity-text-align: middle-center;" />
        <ui:Button name="ResultsContinueButton" text="В главное меню" class="button-primary" />
    </ui:VisualElement>
</ui:UXML>
