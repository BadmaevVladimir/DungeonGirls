/* 7.2 [ОБНОВЛЕНО]: весь текст UI должен иметь обводку/тень для читаемости поверх произвольного
   фона. Type-селекторы (Label, Button) покрывают весь проект разом — хаб/здания/гача/забег — а не
   только окно левел-апа, как явно предпочитает ГДД ("и желательно — во всём UI"). Обводка сменена
   со светлой на тёмную (светлая обводка на светлом тексте почти не давала контраста, наоборот
   смазывала буквы) — стандартный игровой приём "светлый текст + тёмный контур". */
/* UI Toolkit по умолчанию рисует часть программно созданных Label чёрным. В тёмном
   интерфейсе это делает, например, статистику предмета и карточки наставников
   практически невидимыми. Базовый светлый цвет обязателен, а локальные классы
   ниже могут его намеренно переопределять. */
Label {
    color: rgb(242, 242, 246);
    -unity-text-outline-width: 0.75px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.92);
}

Button {
    color: rgb(250, 250, 252);
    -unity-text-outline-width: 0.75px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.92);
}

.full-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(24, 24, 28);
}

.hidden {
    display: none;
}

/* Черновое окно паузы: приоритет — читабельность текущего состояния, не финальная стилизация. */
.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.72);
}

.pause-card {
    width: 720px;
    max-height: 900px;
    padding: 22px;
    background-color: rgb(28, 28, 34);
    border-width: 1px;
    border-color: rgb(135, 115, 70);
    border-radius: 8px;
}

.pause-section-title {
    margin-top: 12px;
    color: rgb(240, 210, 125);
    font-size: 20px;
    -unity-font-style: bold;
}

.pause-scroll {
    max-height: 180px;
    margin-top: 4px;
    background-color: rgb(20, 20, 25);
    border-radius: 4px;
    padding: 8px;
}

.pause-actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
}

.pause-columns {
    flex-direction: row;
    margin-top: 10px;
}

.pause-equipment-column {
    margin-right: 24px;
}

.pause-stats-column {
    flex-grow: 1;
    flex-shrink: 1;
}

.pause-stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    background-color: rgb(20, 20, 25);
    border-radius: 4px;
    padding: 10px 12px;
}

.pause-stat-row {
    width: 50%;
    flex-direction: row;
    justify-content: space-between;
    padding-right: 8px;
    margin-bottom: 4px;
}

.pause-stat-row-label {
    color: rgb(190, 190, 196);
    font-size: 13px;
}

.pause-stat-row-value {
    color: rgb(232, 232, 236);
    font-size: 13px;
    -unity-font-style: bold;
}

.equipment-grid {
    flex-direction: row;
}

.equipment-slot-column {
    flex-direction: column;
    justify-content: space-between;
    height: 250px;
}

.equipment-slot-column-left {
    margin-right: 6px;
}

.equipment-slot-column-right {
    margin-left: 6px;
}

.equipment-slot {
    width: 58px;
    height: 58px;
    background-color: rgb(20, 20, 25);
    border-width: 1px;
    border-color: rgb(90, 80, 60);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
}

.equipment-slot-icon {
    width: 34px;
    height: 34px;
    -unity-background-scale-mode: scale-to-fit;
}

.equipment-portrait {
    width: 128px;
    height: 250px;
    background-color: rgb(20, 20, 25);
    border-width: 1px;
    border-color: rgb(135, 115, 70);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.equipment-portrait-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.title-label {
    font-size: 52px;
    color: rgb(240, 240, 240);
    -unity-font-style: bold;
    margin-bottom: 40px;
}

.button-primary {
    background-color: rgb(70, 100, 160);
    color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 4px;
    padding: 10px 20px;
    font-size: 20px;
    margin: 6px;
}

.button-primary:hover {
    background-color: rgb(90, 120, 180);
}

.button-secondary {
    background-color: rgb(70, 70, 78);
    color: rgb(230, 230, 230);
    border-width: 0;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 18px;
    margin: 6px;
}

.button-secondary:hover {
    background-color: rgb(90, 90, 98);
}

.run-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    background-color: rgb(18, 18, 22);
}

.top-bar {
    height: 64px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(32, 32, 38);
    padding: 8px 16px;
    justify-content: space-between;
}

.top-bar-label {
    color: rgb(230, 230, 230);
    font-size: 18px;
    -unity-font-style: bold;
}

.room-progress-row {
    flex-direction: row;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.room-pip {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin-left: 3px;
    margin-right: 3px;
    background-color: rgb(80, 80, 88);
}

.room-pip-done {
    background-color: rgb(90, 180, 100);
}

.room-pip-current {
    background-color: rgb(230, 200, 60);
}

.room-pip-boss {
    background-color: rgb(200, 60, 60);
    width: 18px;
    height: 18px;
    border-radius: 9px;
}

.main-row {
    flex-direction: row;
    flex-grow: 1;
}

.content-area {
    flex-grow: 1;
    padding: 16px;
}

.run-log-panel {
    width: 340px;
    flex-shrink: 0;
    background-color: rgb(26, 26, 32);
    padding: 12px;
    border-left-width: 1px;
    border-left-color: rgb(50, 50, 58);
}

.panel {
    background-color: rgb(30, 30, 36);
    border-radius: 6px;
    padding: 16px;
    flex-grow: 1;
}

.combat-title-badge {
    align-self: flex-start;
    background-color: rgba(20, 20, 25, 0.75);
    color: rgb(255, 240, 200);
    font-size: 15px;
    -unity-font-style: bold;
    padding: 4px 12px;
    border-radius: 6px;
    margin-bottom: 8px;
}

.map-panel {
    flex-direction: column;
}

/* Каркас run-экранов (предмет/привал/торговец/событие/ловушка/левел-ап) — цветная шапка по типу
   вместо плоской панели без рамки, см. брейнсторм "комплексная переработка окон" 2026-09-04. */

.run-panel {
    background-color: rgb(26, 26, 31);
    border-radius: 8px;
    overflow: hidden;
    flex-grow: 1;
    padding: 0;
}

.run-panel-header {
    flex-direction: row;
    align-items: center;
    padding: 12px 18px;
    border-bottom-width: 2px;
}

.run-panel-header-title {
    font-size: 19px;
    -unity-font-style: bold;
}

.run-panel-body {
    padding: 16px 18px;
    flex-grow: 1;
}

.run-panel-header-item {
    background-color: rgb(58, 50, 30);
    border-bottom-color: rgb(240, 210, 125);
    color: rgb(255, 240, 200);
}

.run-panel-header-camp {
    background-color: rgb(46, 66, 46);
    border-bottom-color: rgb(100, 170, 100);
    color: rgb(220, 245, 220);
}

.run-panel-header-merchant {
    background-color: rgb(34, 48, 64);
    border-bottom-color: rgb(120, 170, 230);
    color: rgb(220, 235, 250);
}

.run-panel-header-event {
    background-color: rgb(58, 38, 32);
    border-bottom-color: rgb(212, 120, 80);
    color: rgb(250, 220, 205);
}

.run-panel-header-trap {
    background-color: rgb(64, 34, 34);
    border-bottom-color: rgb(210, 90, 90);
    color: rgb(250, 215, 215);
}

.run-panel-header-levelup {
    background-color: rgb(48, 38, 60);
    border-bottom-color: rgb(170, 140, 220);
    color: rgb(235, 225, 250);
}

.map-status-label {
    margin-bottom: 10px;
}

.floor-map-scroll {
    flex-grow: 1;
    min-height: 500px;
    background-color: rgb(22, 22, 28);
    border-radius: 6px;
    padding: 10px;
}

.floor-map-strip {
    flex-direction: row;
    align-items: stretch;
    min-height: 450px;
}

.floor-map-node-column {
    width: 112px;
    flex-shrink: 0;
    align-items: center;
}

.floor-map-common-column {
    justify-content: center;
}

.floor-map-depth-label {
    height: 30px;
    -unity-text-align: middle-center;
    color: rgb(190, 190, 205);
    -unity-font-style: bold;
}

.floor-map-node {
    width: 104px;
    height: 92px;
    margin-top: 4px;
    margin-bottom: 4px;
    white-space: normal;
    -unity-text-align: middle-center;
    background-color: rgb(56, 56, 66);
    border-color: rgb(85, 85, 98);
    border-width: 2px;
}

.floor-map-node-visited {
    background-color: rgb(48, 91, 58);
    border-color: rgb(91, 170, 105);
}

.floor-map-node-current {
    background-color: rgb(75, 96, 145);
    border-color: rgb(128, 170, 255);
}

.floor-map-node-reachable {
    background-color: rgb(112, 75, 25);
    border-color: rgb(255, 190, 66);
    color: rgb(255, 244, 205);
}

.floor-map-node-future {
    opacity: 0.55;
}

.floor-map-edge-column {
    width: 94px;
    flex-shrink: 0;
    align-items: stretch;
}

#EdgeColumnSpacer {
    height: 30px;
}

.floor-map-edge-label {
    height: 100px;
    -unity-text-align: middle-center;
    color: rgb(205, 177, 100);
    font-size: 11px;
    white-space: normal;
}

.floor-map-legend {
    margin-top: 8px;
    color: rgb(155, 155, 170);
    font-size: 12px;
}

.panel-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    margin-bottom: 10px;
}

.body-label {
    font-size: 17px;
    color: rgb(232, 232, 236);
    white-space: normal;
    margin-bottom: 10px;
}

/* --- Бой --- */

.combat-background {
    position: absolute;
    /* Absolutely-positioned children resolve left/top/right/bottom against the parent's PADDING box
       in Yoga, not its border box. CombatPanel is a .panel (padding: 16px), so 0 here would leave a
       16px gap of panel background showing on all four sides. Offset by -16px (negative of .panel's
       padding) so this fills the panel's actual border box instead. */
    left: -16px;
    top: -16px;
    right: -16px;
    bottom: -16px;
    border-radius: 6px; /* matches .panel's border-radius so corners don't show a background square poking out */
}

.combat-top-row {
    flex-direction: row;
    justify-content: space-between;
}

.combatant-box {
    background-color: rgba(24, 24, 31, 0.94);
    border-width: 1px;
    border-color: rgba(150, 150, 165, 0.45);
    border-radius: 4px;
    padding: 8px;
    margin-bottom: 6px;
    min-width: 220px;
}

.combatant-box-target {
    border-width: 2px;
    border-color: rgb(230, 200, 60);
}

.combatant-name {
    color: rgb(240, 240, 240);
    font-size: 18px;
    -unity-font-style: bold;
}

.combat-stage {
    position: absolute;
    left: -16px;
    top: -16px;
    right: -16px;
    bottom: -16px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding: 32px;
}

.stage-sprite {
    width: 384px;
    height: 384px;
}

/* 4.7: обёртка над спрайтом бойца — сам спрайт остаётся обычным flow-элементом (на нём же
   держится marginBottom для anchoring на линии пола), а всплывающие цифры урона и подпись
   баф/дебафф — position:absolute поверх/под ним, не влияя на Yoga-размер обёртки. */
.stage-sprite-wrapper {
    position: relative;
    align-items: center;
}

.stealth-stage-active {
    background-color: rgba(24, 80, 105, 0.24);
    border-width: 3px;
    border-color: rgb(82, 224, 255);
    border-radius: 28px;
}

.stealth-stage-active .stage-sprite {
    -unity-background-image-tint-color: rgb(155, 235, 255);
    /* (доп.) сам спрайт полупрозрачный, пока активна Скрытность — независимо от источника
       (Дымовая граната, Ускользание и т.п.), поверх уже существующего голубого tint/рамки. */
    opacity: 0.55;
}

.enemy-stage-row {
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-end;
}

.enemy-stage-sprite-wrapper {
    position: relative;
    align-items: center;
    margin-left: 12px;
}

.enemy-stage-sprite {
    width: 100%;
    height: 100%;
}

.enemy-stage-sprite-dead {
    opacity: 0.4;
}

/* 4.7: всплывающие цифры урона — спавнятся над головой бойца и улетают вверх с затуханием. */
.floating-combat-text {
    position: absolute;
    left: 50%;
    top: 10%;
    min-width: 40px;
    padding: 4px 9px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 245, 220);
    background-color: rgba(12, 10, 14, 0.88);
    border-width: 1px;
    border-color: rgba(255, 226, 156, 0.9);
    border-radius: 8px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.floating-combat-text-crit {
    font-size: 30px;
    color: rgb(255, 212, 78);
    background-color: rgba(60, 22, 10, 0.94);
    border-color: rgb(255, 168, 46);
}

.floating-combat-text-block {
    min-width: 68px;
    font-size: 18px;
    color: rgb(205, 230, 255);
    background-color: rgba(14, 30, 52, 0.94);
    border-color: rgb(105, 175, 244);
}

/* Boss framework (минимальный слайс) — reusable-телеграф "готовит особую атаку", над головой
   конкретного противника (см. RunFlowController.BuildEnemyStageEntries/UpdateBossTelegraph). Тёплый
   тревожный цвет, чтобы не путаться с обычными баф/дебафф-баджами (.combat-status-badge) ниже. */
.boss-telegraph-label {
    position: absolute;
    top: -34px;
    left: 50%;
    translate: -50% 0;
    min-width: 90px;
    padding: 3px 8px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 224, 168);
    background-color: rgba(74, 24, 10, 0.92);
    border-width: 1px;
    border-color: rgb(255, 140, 46);
    border-radius: 6px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.boss-telegraph-bar-bg {
    position: absolute;
    top: -10px;
    left: 50%;
    translate: -50% 0;
    width: 60%;
    height: 6px;
    background-color: rgba(40, 14, 8, 0.85);
    border-radius: 3px;
    overflow: hidden;
}

.boss-telegraph-bar-fill {
    height: 100%;
    background-color: rgb(255, 140, 46);
}

/* 4.7 [ОБНОВЛЕНО]: список баффов/дебаффов участника боя — под спрайтом. Прошлая пастель почти не
   читалась на тёмном каменном фоне сцены (низкий контраст) — цвета (заданы прямо в тексте лейбла,
   см. RunFlowController.UpdateStatusLabel) сделаны средне-насыщенными, плюс тёмная подложка-пилюля
   под всем блоком гарантирует читаемость независимо от фона позади. Пустой список скрывается
   целиком кодом (EnableInClassList("hidden", ...)), чтобы пустая пилюля не висела зря. */
.stage-status-label {
    position: absolute;
    bottom: -4px;
    left: 50%;
    translate: -50% 0;
    font-size: 13px;
    padding: 2px 6px;
    border-radius: 6px;
    background-color: rgba(10, 10, 14, 0.55);
    -unity-text-align: upper-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    white-space: normal;
}

.resource-indicator {
    margin-top: 7px;
    padding: 6px 8px;
    border-width: 2px;
    border-radius: 6px;
}

.resource-indicator-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 247, 225);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.rage-indicator {
    background-color: rgba(76, 24, 12, 0.96);
    border-color: rgb(221, 104, 42);
}

.rage-indicator-high {
    background-color: rgba(104, 13, 10, 0.98);
    border-color: rgb(255, 70, 35);
}

.resource-bar-bg {
    height: 11px;
    margin-top: 4px;
    background-color: rgb(35, 17, 16);
    border-width: 1px;
    border-color: rgba(255, 190, 120, 0.7);
    border-radius: 4px;
    overflow: hidden;
}

.resource-bar-fill {
    height: 100%;
}

.rage-bar-fill {
    background-color: rgb(236, 75, 28);
}

.stealth-indicator {
    background-color: rgba(8, 48, 68, 0.98);
    border-color: rgb(82, 224, 255);
}

.stealth-indicator-label {
    color: rgb(135, 240, 255);
    -unity-text-align: middle-center;
}

.combat-status-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.combat-status-badge {
    margin-right: 5px;
    margin-bottom: 5px;
    padding: 4px 7px;
    border-width: 2px;
    border-radius: 5px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(250, 250, 252);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.combat-status-buff {
    background-color: rgba(24, 79, 42, 0.98);
    border-color: rgb(88, 218, 116);
}

.combat-status-debuff {
    background-color: rgba(102, 25, 31, 0.98);
    border-color: rgb(246, 91, 91);
}

/* 4.7: баннер активации уникального активного навыка — общий на весь бой, верх-центр сцены. */
.skill-activation-banner {
    position: absolute;
    top: 8px;
    left: 50%;
    translate: -50% 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 217, 51);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

.hp-bar-bg {
    height: 14px;
    background-color: rgb(60, 20, 20);
    border-radius: 3px;
    margin-top: 4px;
    overflow: hidden;
}

.hp-bar-fill {
    height: 14px;
    background-color: rgb(200, 60, 60);
}

.hp-bar-fill-player {
    background-color: rgb(80, 180, 90);
}

.hp-text {
    color: rgb(245, 245, 245);
    font-size: 15px;
    margin-top: 2px;
}

.stat-text {
    color: rgb(215, 225, 245);
    font-size: 14px;
    margin-top: 1px;
}

.item-compare-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
    flex-wrap: wrap;
    max-height: 240px;
    overflow: hidden;
}

.item-slot-choice {
    flex-grow: 1;
    flex-basis: 260px;
    min-height: 92px;
    max-height: 230px;
    margin-right: 8px;
    overflow: hidden;
}

/* Карточка выбора слота (комплексная переработка, вариант A) — иконка+название в шапке, ниже
   полная таблица статов предмета: у каждой строки своё "было → стало", а не единственная
   выбранная "главная" дельта — иначе для колец/амулетов с непересекающимися бонусами часть
   информации терялась. */

.item-compare-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.item-compare-card-title {
    flex-grow: 1;
}

.item-compare-card-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    flex-shrink: 0;
    background-color: rgb(38, 36, 44);
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.item-compare-stat-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 3px;
}

.item-compare-stat-value-row {
    flex-direction: row;
}

.item-compare-stat-label {
    color: rgb(150, 150, 158);
    font-size: 12px;
}

.item-compare-stat-value {
    font-size: 12px;
    -unity-font-style: bold;
}

.item-compare-stat-value-old {
    color: rgb(150, 150, 158);
    -unity-font-style: normal;
}

.item-compare-stat-arrow {
    color: rgb(150, 150, 158);
}

.item-compare-stat-up {
    color: rgb(120, 200, 120);
}

.item-compare-stat-down {
    color: rgb(224, 110, 110);
}

.item-compare-stat-neutral {
    color: rgb(190, 190, 196);
}

/* 7.2/8.2 [НОВОЕ]: презентация награды модальным окном поверх текущей сцены (обычно боя) —
   сцена позади не исчезает, а темнеет под скримом, журнал забега (вне ContentArea) остаётся
   поверх. Инсеты -16px компенсируют padding: 16px у .content-area (тот же приём, что и у
   .combat-stage/.combat-background выше — покрыть реальный border box контейнера, а не оставить
   рамку фона по краям). Fade/scale появления и исчезания анимируются кодом (RunFlowController). */
.reward-overlay {
    position: absolute;
    left: -16px;
    top: -16px;
    right: -16px;
    bottom: -16px;
    align-items: center;
    justify-content: center;
}

.reward-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);
}

.reward-modal-card {
    background-color: rgb(32, 30, 34);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(184, 142, 62);
    padding: 20px;
    min-width: 360px;
    max-width: 480px;
    align-items: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.65);
}

.loot-summary-container {
    min-width: 320px;
    align-items: stretch;
}

.loot-summary-title {
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.loot-summary-rows {
    margin-bottom: 14px;
}

.loot-summary-row {
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    padding: 7px 10px;
    margin-bottom: 5px;
    color: rgb(224, 218, 203);
}

.loot-summary-currency { color: rgb(230, 190, 82); }
.loot-summary-chest { color: rgb(160, 190, 245); }
.loot-summary-material { color: rgb(185, 205, 220); }

.chest-reveal-container {
    align-items: center;
    margin-bottom: 12px;
}

.chest-sprite {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 8px;
}

.chest-reel-viewport {
    width: 320px;
    height: 64px;
    overflow: hidden;
    background-color: rgb(20, 20, 24);
    border-radius: 4px;
}

.chest-reel-strip {
    flex-direction: row;
    position: absolute;
    top: 0;
    left: 0;
}

.chest-reel-icon {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
}

/* 8.2 (уточнено): фон слота ленты по редкости — та же палитра, что и .rarity-common/-rare/-epic
   (там цвет текста, здесь фон, поэтому отдельные классы). */
.chest-reel-icon-common {
    background-color: rgb(180, 180, 180);
}

.chest-reel-icon-rare {
    background-color: rgb(90, 150, 230);
}

.chest-reel-icon-epic {
    background-color: rgb(190, 110, 230);
}

/* Временное designer-facing значение Cursed, централизовано здесь до финальной палитры. */
.chest-reel-icon-cursed {
    background-color: rgb(155, 45, 65);
}

.merchant-offers-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.merchant-offer-card {
    width: 220px;
    margin: 6px;
    padding: 10px;
    background-color: rgb(40, 40, 48);
    border-radius: 6px;
}

.merchant-offer-price {
    font-size: 17px;
    color: rgb(230, 200, 60);
    -unity-font-style: bold;
    margin-top: 6px;
}

.merchant-offer-price-original {
    font-size: 14px;
    color: rgb(150, 150, 150);
    -unity-font-style: italic;
}

.merchant-offer-discount-tag {
    font-size: 14px;
    color: rgb(90, 200, 100);
    -unity-font-style: bold;
}

.merchant-offer-buy-button {
    margin-top: 8px;
}

.item-card {
    flex-grow: 1;
    margin: 4px;
    padding: 12px;
    background-color: rgb(47, 47, 58);
    border-width: 2px;
    border-color: rgb(105, 105, 122);
    border-radius: 8px;
}

.item-card-row {
    flex-direction: row;
}

.item-card-icon {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    margin-right: 16px;
    background-color: rgb(28, 28, 34);
    border-width: 1px;
    border-color: rgb(90, 90, 100);
    border-radius: 8px;
}

.item-card-text-column {
    flex-grow: 1;
    flex-shrink: 1;
}

.item-card-border-common { border-color: rgb(180, 180, 180); }
.item-card-border-rare { border-color: rgb(90, 150, 230); }
.item-card-border-epic { border-color: rgb(190, 110, 230); }
.item-card-border-cursed { border-color: rgb(225, 75, 95); }

.item-card-header {
    font-size: 11px;
    -unity-font-style: bold;
    text-transform: uppercase;
    margin-bottom: 2px;
}

.item-card-name {
    font-size: 18px;
    color: rgb(255, 232, 156);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.enemy-list {
    flex-direction: column;
}

.combat-log-scroll {
    height: 140px;
    background-color: rgb(20, 20, 24);
    border-radius: 4px;
    margin-top: 10px;
    margin-bottom: 10px;
}

.combat-log-text {
    color: rgb(225, 225, 230);
    font-size: 15px;
    white-space: normal;
    padding: 6px;
}

.run-log-panel .combat-log-scroll {
    height: auto;
    flex-grow: 1;
}

.skill-panel-container {
    position: absolute;
    bottom: 12px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: flex-end;
}

.skill-slot {
    align-items: center;
    margin-left: 8px;
    margin-right: 8px;
}

.skill-icon-frame {
    width: 64px;
    height: 64px;
    border-width: 3px;
    border-color: rgb(90, 84, 72);
    border-radius: 10px;
    background-color: rgb(38, 36, 44);
    overflow: hidden;
    transition-property: border-color;
    transition-duration: 0.2s;
}

.skill-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.skill-cooldown-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 10, 14, 0.75);
}

.skill-cooldown-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 16px;
    color: rgb(240, 235, 220);
    -unity-font-style: bold;
}

.skill-hotkey-label {
    position: absolute;
    right: 2px;
    bottom: 2px;
    font-size: 11px;
    color: rgb(200, 190, 170);
    background-color: rgba(0, 0, 0, 0.5);
    padding: 1px 3px 1px 3px;
    border-radius: 3px;
}

.skill-icon-ready {
    border-color: rgb(255, 214, 90);
}

.skill-icon-ready-pulse {
    border-color: rgb(255, 245, 200);
}

.skill-icon-toggle-inactive {
    border-color: rgb(90, 84, 72);
    opacity: 0.55;
}

.skill-icon-toggle-active {
    border-color: rgb(255, 70, 35);
    opacity: 1;
}

.skill-auto-toggle {
    width: 20px;
    height: 20px;
    margin-bottom: 4px;
    border-width: 2px;
    border-radius: 4px;
    border-color: rgb(90, 84, 72);
    background-color: rgb(38, 36, 44);
}

.skill-auto-toggle-on {
    border-color: rgb(120, 200, 120);
    background-color: rgb(60, 110, 60);
}

/* --- Карточки левел-апа / выбора --- */

.choice-card {
    background-color: rgb(55, 55, 68);
    color: rgb(248, 248, 252);
    border-width: 1px;
    border-color: rgb(135, 135, 150);
    border-radius: 6px;
    padding: 14px 16px;
    margin-bottom: 10px;
    white-space: normal;
    -unity-text-align: upper-left;
    height: auto;
}

.choice-card:hover {
    background-color: rgb(75, 75, 92);
    border-color: rgb(240, 210, 125);
}

.choice-card-title-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.choice-card-title {
    color: rgb(248, 248, 252);
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
}

.choice-card-level-badge {
    background-color: rgb(38, 36, 44);
    color: rgb(240, 210, 125);
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 10px;
    margin-left: 8px;
    flex-shrink: 0;
}

.choice-card-description {
    color: rgb(190, 190, 196);
    font-size: 13px;
    white-space: normal;
}

/* --- Редкость (8.2): серый/синий/фиолетовый --- */

.rarity-common {
    color: rgb(180, 180, 180);
}

.rarity-rare {
    color: rgb(90, 150, 230);
}

.rarity-epic {
    color: rgb(190, 110, 230);
}

.rarity-cursed {
    color: rgb(225, 75, 95);
}

.rarity-swatch {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    margin-right: 8px;
}

.swatch-common {
    background-color: rgb(150, 150, 150);
}

.swatch-rare {
    background-color: rgb(70, 120, 220);
}

.swatch-epic {
    background-color: rgb(160, 80, 220);
}

.results-victory {
    color: rgb(90, 200, 100);
    font-size: 40px;
    -unity-font-style: bold;
    margin-bottom: 20px;
}

.results-defeat {
    color: rgb(210, 80, 80);
    font-size: 40px;
    -unity-font-style: bold;
    margin-bottom: 20px;
}

.results-attestation-panel {
    align-items: center;
    min-width: 420px;
    padding: 18px;
    margin-bottom: 16px;
    background-color: rgb(35, 33, 45);
    border-width: 2px;
    border-color: rgb(190, 160, 85);
    border-radius: 10px;
}

.results-portrait {
    width: 96px;
    height: 96px;
    margin-bottom: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.results-attestation-stage {
    color: rgb(225, 215, 190);
    font-size: 18px;
    margin-bottom: 8px;
}

.results-rank-track {
    color: rgb(150, 145, 165);
    font-size: 20px;
    letter-spacing: 2px;
}

.results-final-rank {
    color: rgb(245, 205, 95);
    font-size: 52px;
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 8px;
}

/* --- Таверна / Кузница (доработка Codex: крафт-экраны, 8.1/8.2) --- */

.craft-screen-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.craft-screen-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(15, 13, 12, 0.62);
}

.craft-details-icon {
    width: 56px;
    height: 56px;
    align-self: center;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.resource-chip-icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.recipe-card-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.recipe-card-row {
    flex-direction: row;
    align-items: center;
}

.recipe-card-text {
    flex-shrink: 1;
    white-space: normal;
    color: rgb(232, 232, 236);
    font-size: 15px;
}

.icon-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.icon-row-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.icon-row-icon-large {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.icon-row-text {
    flex-shrink: 1;
    white-space: normal;
}

.craft-screen-header {
    width: 100%;
    max-width: 1100px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}

.resource-bar-row {
    width: 100%;
    max-width: 1100px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 14px;
}

.resource-chip {
    flex-direction: row;
    align-items: center;
    background-color: rgb(40, 40, 48);
    border-width: 1px;
    border-color: rgb(90, 90, 100);
    border-radius: 5px;
    padding: 6px 12px;
    margin: 4px;
}

.resource-chip-label {
    font-size: 15px;
    color: rgb(224, 218, 203);
}

.craft-screen-body {
    width: 100%;
    max-width: 1100px;
    flex-grow: 1;
    flex-direction: row;
}

.craft-recipe-scroll {
    flex-grow: 1;
    flex-basis: 60%;
    max-height: 620px;
    background-color: rgb(22, 22, 28);
    border-radius: 6px;
    padding: 10px;
    margin-right: 14px;
}

.craft-details-panel {
    width: 380px;
    flex-shrink: 0;
    align-items: stretch;
}

.recipe-card {
    background-color: rgb(40, 40, 48);
    color: rgb(232, 232, 236);
    border-width: 1px;
    border-color: rgb(105, 105, 122);
    border-radius: 6px;
    padding: 10px 12px;
    margin-bottom: 6px;
    white-space: normal;
    -unity-text-align: upper-left;
    height: auto;
}

.recipe-card:hover {
    background-color: rgb(52, 52, 62);
}

.recipe-card-selected {
    border-width: 2px;
    border-color: rgb(184, 142, 62);
}

.recipe-card-locked {
    opacity: 0.55;
}

.resource-cost-row {
    font-size: 15px;
    margin-bottom: 3px;
    white-space: normal;
}

.resource-cost-ok {
    color: rgb(120, 210, 130);
}

.resource-cost-missing {
    color: rgb(230, 110, 100);
}

.craft-feedback-label {
    -unity-text-align: middle-center;
    color: rgb(120, 210, 130);
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 6px;
}

.craft-feedback-error {
    color: rgb(232, 184, 92);
}

.forge-category-row {
    width: 100%;
    max-width: 1100px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 10px;
}

.forge-category-tab {
    background-color: rgb(40, 40, 48);
    color: rgb(200, 200, 210);
    border-width: 1px;
    border-color: rgb(90, 90, 100);
    border-radius: 5px;
    padding: 7px 14px;
    margin: 3px;
    font-size: 15px;
}

.forge-category-tab-active {
    background-color: rgb(70, 100, 160);
    color: rgb(255, 255, 255);
    border-color: rgb(184, 142, 62);
}

.forge-weapon-card {
    background-color: rgb(40, 40, 48);
    color: rgb(232, 232, 236);
    border-width: 1px;
    border-color: rgb(160, 80, 220);
    border-radius: 6px;
    padding: 10px 12px;
    margin-bottom: 6px;
    white-space: normal;
    -unity-text-align: upper-left;
    height: auto;
}

.forge-weapon-card:hover {
    background-color: rgb(52, 52, 62);
}

.forge-weapon-card-selected {
    border-width: 2px;
    border-color: rgb(184, 142, 62);
}

.forge-weapon-card-locked {
    opacity: 0.55;
    border-color: rgb(90, 90, 100);
}

.forge-weapon-card-created {
    border-color: rgb(90, 200, 100);
}

.prepared-dishes-container {
    width: 100%;
    flex-direction: column;
    margin-bottom: 10px;
}

.prepared-dish-row {
    background-color: rgb(40, 40, 48);
    color: rgb(232, 232, 236);
    border-width: 1px;
    border-color: rgb(105, 105, 122);
    border-radius: 5px;
    padding: 8px 12px;
    margin-bottom: 5px;
    white-space: normal;
    -unity-text-align: upper-left;
    height: auto;
}

.prepared-dish-row-selected {
    border-width: 2px;
    border-color: rgb(184, 142, 62);
}

/* --- Хаб / здания / гача (Фаза 5) --- */

.currency-label {
    font-size: 21px;
    color: rgb(230, 200, 60);
    -unity-font-style: bold;
    margin-bottom: 20px;
}

.buildings-row {
    flex-direction: row;
    justify-content: center;
}

.building-card {
    background-color: rgb(30, 30, 36);
    border-radius: 6px;
    padding: 16px;
    margin: 8px;
    width: 320px;
}

.building-card-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    margin-bottom: 8px;
}

/* --- Выбор персонажа перед забегом (Core Loop 1 п.2 / 7.2) --- */

.character-select-cards-row {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
}

.character-select-card {
    width: 330px;
    min-height: 640px;
    margin: 8px;
    padding: 14px;
    background-color: rgb(30, 30, 36);
    border-width: 1px;
    border-color: rgb(70, 70, 82);
    border-radius: 8px;
    align-items: stretch;
}

.character-select-portrait-frame {
    height: 350px;
    overflow: hidden;
    background-color: rgb(18, 18, 22);
    border-radius: 6px;
    margin-bottom: 10px;
}

.character-select-portrait {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.character-select-class {
    color: rgb(190, 200, 220);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.character-select-stat {
    color: rgb(215, 215, 215);
    font-size: 16px;
    margin-bottom: 3px;
}

.character-select-skill {
    color: rgb(230, 200, 90);
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 6px;
    padding: 4px;
    border-radius: 3px;
}

.character-select-skill:hover {
    color: rgb(255, 230, 120);
    background-color: rgb(48, 48, 58);
}

.character-skill-tooltip {
    position: absolute;
    width: 360px;
    max-width: 420px;
    padding: 12px;
    background-color: rgba(18, 18, 22, 0.97);
    border-width: 1px;
    border-color: rgb(184, 142, 62);
    border-radius: 6px;
}

.character-skill-tooltip-text {
    color: rgb(240, 240, 240);
    font-size: 16px;
    white-space: normal;
}

/* --- Выбор наставника перед забегом (Core Loop 1 п.3 / 7.2) --- */
.mentor-select-scroll {
    width: 760px;
    max-height: 620px;
    margin-top: 12px;
    margin-bottom: 12px;
}

.mentor-select-card {
    margin: 6px;
    padding: 14px;
    background-color: rgb(37, 37, 46);
    border-width: 1px;
    border-color: rgb(70, 70, 82);
    border-radius: 8px;
}

.mentor-select-grade {
    color: rgb(255, 215, 90);
    font-size: 22px;
    -unity-font-style: bold;
}

.mentor-select-actions {
    flex-direction: row;
    justify-content: center;
}

/* --- Обучение, постоянная справка и контекстные тултипы --- */

.help-inline-button {
    width: 36px;
    min-width: 36px;
    height: 30px;
    margin-left: 10px;
    padding: 2px;
    font-size: 17px;
    -unity-font-style: bold;
}

.run-log-toggle-button {
    width: auto;
    min-width: 90px;
    font-size: 14px;
}

.tutorial-overlay,
.settings-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(7, 7, 10, 0.88);
    align-items: center;
    justify-content: center;
}

.settings-card {
    width: 480px;
    max-width: 90%;
    padding: 28px;
    background-color: rgb(27, 27, 34);
    border-width: 2px;
    border-color: rgb(95, 105, 128);
    border-radius: 10px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
    margin-bottom: 24px;
}

.settings-slider {
    flex-grow: 1;
    margin-left: 12px;
    margin-right: 12px;
}

.settings-value-label {
    width: 48px;
    color: rgb(220, 220, 225);
    -unity-text-align: middle-right;
}

.help-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(7, 7, 10, 0.88);
    align-items: center;
    justify-content: center;
}

.tutorial-card {
    width: 640px;
    max-width: 90%;
    padding: 28px;
    background-color: rgb(27, 27, 34);
    border-width: 2px;
    border-color: rgb(184, 142, 62);
    border-radius: 10px;
}

.tutorial-title {
    color: rgb(255, 218, 115);
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 14px;
}

.tutorial-body {
    color: rgb(235, 235, 238);
    font-size: 19px;
    white-space: normal;
    margin-bottom: 20px;
}

.help-card {
    width: 900px;
    max-width: 92%;
    height: 86%;
    padding: 24px;
    background-color: rgb(24, 24, 30);
    border-width: 2px;
    border-color: rgb(95, 105, 128);
    border-radius: 10px;
}

.help-scroll {
    flex-grow: 1;
    margin-top: 8px;
    margin-bottom: 14px;
}

.help-section {
    padding: 12px;
    margin-bottom: 8px;
    background-color: rgb(34, 34, 42);
    border-radius: 5px;
}

/* Заголовок раздела Справки (Забег / Бой / Развитие героини / Деревня): раньше 23 подсказки шли
   одним сплошным списком, и найти нужную можно было только перечитав всё. */
.help-group-title {
    color: rgb(150, 200, 255);
    font-size: 25px;
    -unity-font-style: bold;
    margin-top: 16px;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(70, 74, 92);
}

.help-section-title {
    color: rgb(255, 218, 115);
    font-size: 21px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.help-section-body {
    color: rgb(220, 220, 225);
    font-size: 16px;
    white-space: normal;
}

.global-tooltip {
    position: absolute;
    width: 390px;
    max-width: 45%;
    padding: 12px;
    background-color: rgba(18, 18, 23, 0.98);
    border-width: 1px;
    border-color: rgb(184, 142, 62);
    border-radius: 6px;
}

.global-tooltip-title {
    color: rgb(255, 218, 115);
    font-size: 17px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.global-tooltip-body {
    color: rgb(238, 238, 240);
    font-size: 15px;
    white-space: normal;
}

/* ==================== Главное меню: деревня (карта + левая панель) ====================
   Портирован утверждённый макет main_menu_village_v5.html. Веб-приёмы, которых нет в
   UI Toolkit, заменены: градиенты — плоскими цветами, radial-gradient — спрайтом SoftGlow,
   @keyframes — корутинами в HubManager.Village.cs, aspect-ratio — расчётом в C#,
   ::after-«хвостики» плашек — опущены (плашка и так примыкает к зданию). */

.village-shell {
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
    background-color: rgb(18, 16, 22);
}

/* Попапы чит-меню и сброса прогресса остаются обычными детьми MainMenuScreen (разметка не
   менялась), но в row-раскладке их нужно вынуть из потока — иначе они встали бы третьей колонкой. */
.village-shell > .panel {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
}

/* ---------- левая панель ---------- */
.village-nav-panel {
    width: 320px;
    flex-shrink: 0;
    background-color: rgb(28, 25, 34);
    border-right-width: 1px;
    border-right-color: rgb(51, 46, 60);
    padding: 36px 24px 24px 24px;
    flex-direction: column;
}

.village-brand {
    margin-bottom: 16px;
}

.village-brand-eyebrow {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(138, 106, 44);
    margin-bottom: 6px;
}

.village-brand-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(236, 227, 209);
    margin: 0;
}

.village-brand-title-accent {
    color: rgb(219, 164, 63);
}

.village-hint-row {
    font-size: 13px;
    color: rgb(107, 101, 88);
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(51, 46, 60);
    white-space: normal;
}

.village-nav-list {
    flex-direction: column;
    flex-grow: 1;
}

.village-nav-item {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 6px;
    padding: 11px 10px 11px 10px;
    margin: 1px 0 1px 0;
    color: rgb(157, 150, 137);
    font-size: 14px;
    -unity-text-align: middle-left;
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.village-nav-item:hover {
    background-color: rgb(36, 32, 48);
    color: rgb(236, 227, 209);
    border-left-color: rgb(79, 132, 137);
}

.village-panel-footer {
    border-top-width: 1px;
    border-top-color: rgb(51, 46, 60);
    padding-top: 12px;
    margin-top: 16px;
    flex-direction: column;
}

.village-footer-link {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 6px;
    padding: 7px 10px 7px 10px;
    margin: 1px 0 1px 0;
    font-size: 13px;
    color: rgb(107, 101, 88);
    -unity-text-align: middle-left;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.village-footer-link:hover {
    background-color: rgb(36, 32, 48);
    color: rgb(157, 150, 137);
}

.village-footer-link-danger:hover {
    color: rgb(168, 72, 60);
}

/* ---------- сцена с картой ---------- */
.village-stage {
    flex-grow: 1;
    background-color: rgb(13, 11, 16);
    align-items: center;
    justify-content: center;
    padding: 14px;
    overflow: hidden;
}

/* Размер задаётся из C# (HubManager.Village.cs) — в UI Toolkit нет aspect-ratio. */
.village-map-root {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
}

.village-map-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.village-fx {
    position: absolute;
}

.village-water-shimmer {
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.6;
}

.village-cloud {
    -unity-background-scale-mode: scale-and-crop;
}

.village-cloud-0 {
    width: 38%;
    height: 34%;
    top: -12%;
}

.village-cloud-1 {
    width: 26%;
    height: 24%;
    top: 26%;
}

.village-cloud-2 {
    width: 32%;
    height: 30%;
    top: 58%;
}

.village-glow {
    -unity-background-scale-mode: scale-and-crop;
}

.village-glow-forge {
    left: 32.5%;
    top: 20%;
    width: 8%;
    height: 9%;
    -unity-background-image-tint-color: rgba(255, 168, 58, 0.75);
}

.village-glow-tavern {
    left: 70.5%;
    top: 45%;
    width: 9%;
    height: 9%;
    -unity-background-image-tint-color: rgba(255, 196, 96, 0.55);
}

.village-glow-fountain {
    left: 46.5%;
    top: 42%;
    width: 9%;
    height: 9%;
    -unity-background-image-tint-color: rgba(190, 232, 255, 0.6);
}

.village-glow-dungeon {
    left: 47%;
    top: 73%;
    width: 16%;
    height: 15%;
    -unity-background-image-tint-color: rgba(158, 116, 206, 0.55);
}

.village-mist {
    left: 50.5%;
    top: 68%;
    width: 9%;
    height: 16%;
}

.village-mist-puff {
    position: absolute;
    bottom: 0;
    width: 62%;
    height: 55%;
    opacity: 0;
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgba(176, 150, 214, 0.6);
}

.village-mist-puff-0 {
    left: 50%;
}

.village-mist-puff-1 {
    left: 28%;
}

.village-mist-puff-2 {
    left: 70%;
}

/* ---------- кликабельные зоны ---------- */
.village-spot {
    position: absolute;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    padding: 0;
    margin: 0;
    min-width: auto;
    min-height: auto;
    overflow: visible;
}

.village-spot-forge {
    left: 23.7%;
    top: 10%;
    width: 20.6%;
    height: 27.5%;
}

.village-spot-temple {
    left: 60.9%;
    top: 0;
    width: 15.8%;
    height: 31.2%;
}

.village-spot-tavern {
    left: 65.7%;
    top: 36.2%;
    width: 17.4%;
    height: 25%;
}

.village-spot-dungeon {
    left: 41.9%;
    top: 58.7%;
    width: 26.1%;
    height: 36.2%;
}

/* radial-gradient в USS нет — подсветка при наведении рисуется спрайтом SoftGlow.png. */
.village-spot-glow {
    position: absolute;
    left: -16%;
    top: -16%;
    right: -16%;
    bottom: -16%;
    opacity: 0;
    -unity-background-scale-mode: scale-and-crop;
    transition-property: opacity;
    transition-duration: 0.18s;
}

.village-spot:hover > .village-spot-glow {
    opacity: 1;
}

.village-spot-glow-forge {
    -unity-background-image-tint-color: rgba(255, 170, 60, 0.5);
}

.village-spot-glow-temple {
    -unity-background-image-tint-color: rgba(168, 206, 230, 0.5);
}

.village-spot-glow-tavern {
    -unity-background-image-tint-color: rgba(255, 190, 90, 0.5);
}

.village-spot-glow-dungeon {
    -unity-background-image-tint-color: rgba(158, 116, 206, 0.55);
}

/* ---------- плашки с названиями ---------- */
.village-plate {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    background-color: rgb(239, 225, 188);
    border-width: 2px;
    border-color: rgb(107, 79, 42);
    border-radius: 3px;
    padding: 3px 10px 4px 10px;
    align-items: center;
    transition-property: translate;
    transition-duration: 0.15s;
}

.village-plate-above {
    bottom: 100%;
    margin-bottom: 7px;
}

.village-plate-below {
    top: 100%;
    margin-top: 7px;
}

.village-spot:hover > .village-plate {
    translate: -50% -2px;
}

.village-plate-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(63, 44, 21);
    -unity-text-outline-width: 0;
    white-space: nowrap;
}

.village-plate-level {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(122, 90, 42);
    -unity-text-outline-width: 0;
    margin-top: 1px;
    white-space: nowrap;
}

/* Плашка подземелья — главное действие сцены; сдвинута вправо, иначе накрывает фонтан. */
.village-plate-dungeon {
    left: 74%;
    background-color: rgb(44, 36, 50);
    border-color: rgb(219, 164, 63);
    padding: 4px 14px 5px 14px;
}

.village-plate-dungeon > .village-plate-name {
    color: rgb(239, 225, 188);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-text-outline-width: 0.75px;
}

.village-plate-cta {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(219, 164, 63);
    letter-spacing: 0.5px;
    margin-top: 1px;
    white-space: nowrap;
}

