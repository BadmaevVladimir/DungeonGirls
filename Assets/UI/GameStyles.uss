/* 7.2 [ОБНОВЛЕНО]: весь текст UI должен иметь обводку/тень для читаемости поверх произвольного
   фона. Type-селекторы (Label, Button) покрывают весь проект разом — хаб/здания/гача/забег — а не
   только окно левел-апа, как явно предпочитает ГДД ("и желательно — во всём UI"). Обводка сменена
   со светлой на тёмную (светлая обводка на светлом тексте почти не давала контраста, наоборот
   смазывала буквы) — стандартный игровой приём "светлый текст + тёмный контур". */
Label, Button {
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

.full-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(24, 24, 28);
}

.hidden {
    display: none;
}

.title-label {
    font-size: 48px;
    color: rgb(240, 240, 240);
    -unity-font-style: bold;
    margin-bottom: 40px;
}

.button-primary {
    background-color: rgb(70, 100, 160);
    color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 4px;
    padding: 10px 20px;
    font-size: 18px;
    margin: 6px;
}

.button-primary:hover {
    background-color: rgb(90, 120, 180);
}

.button-secondary {
    background-color: rgb(70, 70, 78);
    color: rgb(230, 230, 230);
    border-width: 0;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 16px;
    margin: 6px;
}

.button-secondary:hover {
    background-color: rgb(90, 90, 98);
}

.run-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    background-color: rgb(18, 18, 22);
}

.top-bar {
    height: 64px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(32, 32, 38);
    padding: 8px 16px;
    justify-content: space-between;
}

.top-bar-label {
    color: rgb(230, 230, 230);
    font-size: 16px;
    -unity-font-style: bold;
}

.room-progress-row {
    flex-direction: row;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.room-pip {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin-left: 3px;
    margin-right: 3px;
    background-color: rgb(80, 80, 88);
}

.room-pip-done {
    background-color: rgb(90, 180, 100);
}

.room-pip-current {
    background-color: rgb(230, 200, 60);
}

.room-pip-boss {
    background-color: rgb(200, 60, 60);
    width: 18px;
    height: 18px;
    border-radius: 9px;
}

.main-row {
    flex-direction: row;
    flex-grow: 1;
}

.content-area {
    flex-grow: 1;
    padding: 16px;
}

.run-log-panel {
    width: 300px;
    flex-shrink: 0;
    background-color: rgb(26, 26, 32);
    padding: 12px;
    border-left-width: 1px;
    border-left-color: rgb(50, 50, 58);
}

.panel {
    background-color: rgb(30, 30, 36);
    border-radius: 6px;
    padding: 16px;
    flex-grow: 1;
}

.panel-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    margin-bottom: 10px;
}

.body-label {
    font-size: 15px;
    color: rgb(210, 210, 210);
    white-space: normal;
    margin-bottom: 10px;
}

/* --- Бой --- */

.combat-background {
    position: absolute;
    /* Absolutely-positioned children resolve left/top/right/bottom against the parent's PADDING box
       in Yoga, not its border box. CombatPanel is a .panel (padding: 16px), so 0 here would leave a
       16px gap of panel background showing on all four sides. Offset by -16px (negative of .panel's
       padding) so this fills the panel's actual border box instead. */
    left: -16px;
    top: -16px;
    right: -16px;
    bottom: -16px;
    border-radius: 6px; /* matches .panel's border-radius so corners don't show a background square poking out */
}

.combat-top-row {
    flex-direction: row;
    justify-content: space-between;
}

.combatant-box {
    background-color: rgb(40, 40, 48);
    border-radius: 4px;
    padding: 8px;
    margin-bottom: 6px;
    min-width: 220px;
}

.combatant-box-target {
    border-width: 2px;
    border-color: rgb(230, 200, 60);
}

.combatant-name {
    color: rgb(240, 240, 240);
    font-size: 15px;
    -unity-font-style: bold;
}

.combat-stage {
    position: absolute;
    left: -16px;
    top: -16px;
    right: -16px;
    bottom: -16px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding: 32px;
}

.stage-sprite {
    width: 384px;
    height: 384px;
}

/* 4.7: обёртка над спрайтом бойца — сам спрайт остаётся обычным flow-элементом (на нём же
   держится marginBottom для anchoring на линии пола), а всплывающие цифры урона и подпись
   баф/дебафф — position:absolute поверх/под ним, не влияя на Yoga-размер обёртки. */
.stage-sprite-wrapper {
    position: relative;
    align-items: center;
}

.enemy-stage-row {
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-end;
}

.enemy-stage-sprite-wrapper {
    position: relative;
    align-items: center;
    margin-left: 12px;
}

.enemy-stage-sprite {
    width: 100%;
    height: 100%;
}

.enemy-stage-sprite-dead {
    opacity: 0.4;
}

/* 4.7: всплывающие цифры урона — спавнятся над головой бойца и улетают вверх с затуханием. */
.floating-combat-text {
    position: absolute;
    left: 50%;
    top: 10%;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.75);
}

.floating-combat-text-crit {
    font-size: 28px;
    color: rgb(255, 165, 40);
}

.floating-combat-text-block {
    font-size: 16px;
    color: rgb(190, 190, 190);
}

/* 4.7 [ОБНОВЛЕНО]: список баффов/дебаффов участника боя — под спрайтом. Прошлая пастель почти не
   читалась на тёмном каменном фоне сцены (низкий контраст) — цвета (заданы прямо в тексте лейбла,
   см. RunFlowController.UpdateStatusLabel) сделаны средне-насыщенными, плюс тёмная подложка-пилюля
   под всем блоком гарантирует читаемость независимо от фона позади. Пустой список скрывается
   целиком кодом (EnableInClassList("hidden", ...)), чтобы пустая пилюля не висела зря. */
.stage-status-label {
    position: absolute;
    bottom: -4px;
    left: 50%;
    translate: -50% 0;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 6px;
    background-color: rgba(10, 10, 14, 0.55);
    -unity-text-align: upper-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    white-space: normal;
}

/* 4.7: баннер активации уникального активного навыка — общий на весь бой, верх-центр сцены. */
.skill-activation-banner {
    position: absolute;
    top: 8px;
    left: 50%;
    translate: -50% 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 217, 51);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

.hp-bar-bg {
    height: 14px;
    background-color: rgb(60, 20, 20);
    border-radius: 3px;
    margin-top: 4px;
    overflow: hidden;
}

.hp-bar-fill {
    height: 14px;
    background-color: rgb(200, 60, 60);
}

.hp-bar-fill-player {
    background-color: rgb(80, 180, 90);
}

.hp-text {
    color: rgb(220, 220, 220);
    font-size: 11px;
    margin-top: 2px;
}

.stat-text {
    color: rgb(180, 190, 210);
    font-size: 10px;
    margin-top: 1px;
}

.item-compare-row {
    flex-direction: row;
    justify-content: space-between;
}

/* 7.2/8.2 [НОВОЕ]: презентация награды модальным окном поверх текущей сцены (обычно боя) —
   сцена позади не исчезает, а темнеет под скримом, журнал забега (вне ContentArea) остаётся
   поверх. Инсеты -16px компенсируют padding: 16px у .content-area (тот же приём, что и у
   .combat-stage/.combat-background выше — покрыть реальный border box контейнера, а не оставить
   рамку фона по краям). Fade/scale появления и исчезания анимируются кодом (RunFlowController). */
.reward-overlay {
    position: absolute;
    left: -16px;
    top: -16px;
    right: -16px;
    bottom: -16px;
    align-items: center;
    justify-content: center;
}

.reward-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);
}

.reward-modal-card {
    background-color: rgb(32, 30, 34);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(184, 142, 62);
    padding: 20px;
    min-width: 360px;
    max-width: 480px;
    align-items: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.65);
}

.chest-reveal-container {
    align-items: center;
    margin-bottom: 12px;
}

.chest-sprite {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 8px;
}

.chest-reel-viewport {
    width: 320px;
    height: 64px;
    overflow: hidden;
    background-color: rgb(20, 20, 24);
    border-radius: 4px;
}

.chest-reel-strip {
    flex-direction: row;
    position: absolute;
    top: 0;
    left: 0;
}

.chest-reel-icon {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
}

/* 8.2 (уточнено): фон слота ленты по редкости — та же палитра, что и .rarity-common/-rare/-epic
   (там цвет текста, здесь фон, поэтому отдельные классы). */
.chest-reel-icon-common {
    background-color: rgb(180, 180, 180);
}

.chest-reel-icon-rare {
    background-color: rgb(90, 150, 230);
}

.chest-reel-icon-epic {
    background-color: rgb(190, 110, 230);
}

.merchant-offers-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.merchant-offer-card {
    width: 180px;
    margin: 6px;
    padding: 10px;
    background-color: rgb(40, 40, 48);
    border-radius: 6px;
}

.merchant-offer-price {
    font-size: 14px;
    color: rgb(230, 200, 60);
    -unity-font-style: bold;
    margin-top: 6px;
}

.merchant-offer-price-original {
    font-size: 11px;
    color: rgb(150, 150, 150);
    -unity-font-style: italic;
}

.merchant-offer-discount-tag {
    font-size: 11px;
    color: rgb(90, 200, 100);
    -unity-font-style: bold;
}

.merchant-offer-buy-button {
    margin-top: 8px;
}

.item-card {
    flex-grow: 1;
    margin: 4px;
    padding: 8px;
    background-color: rgb(40, 40, 48);
    border-radius: 6px;
}

.item-card-header {
    font-size: 11px;
    color: rgb(160, 160, 170);
}

.item-card-name {
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.enemy-list {
    flex-direction: column;
}

.combat-log-scroll {
    height: 140px;
    background-color: rgb(20, 20, 24);
    border-radius: 4px;
    margin-top: 10px;
    margin-bottom: 10px;
}

.combat-log-text {
    color: rgb(190, 190, 190);
    font-size: 12px;
    white-space: normal;
    padding: 6px;
}

.run-log-panel .combat-log-scroll {
    height: auto;
    flex-grow: 1;
}

.combat-controls-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

/* --- Карточки левел-апа / выбора --- */

.choice-card {
    background-color: rgb(45, 45, 54);
    border-radius: 4px;
    padding: 12px;
    margin-bottom: 8px;
    white-space: normal;
    -unity-text-align: upper-left;
    height: auto;
}

.choice-card:hover {
    background-color: rgb(60, 60, 72);
}

/* --- Редкость (8.2): серый/синий/фиолетовый --- */

.rarity-common {
    color: rgb(180, 180, 180);
}

.rarity-rare {
    color: rgb(90, 150, 230);
}

.rarity-epic {
    color: rgb(190, 110, 230);
}

.rarity-swatch {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    margin-right: 8px;
}

.swatch-common {
    background-color: rgb(150, 150, 150);
}

.swatch-rare {
    background-color: rgb(70, 120, 220);
}

.swatch-epic {
    background-color: rgb(160, 80, 220);
}

.results-victory {
    color: rgb(90, 200, 100);
    font-size: 40px;
    -unity-font-style: bold;
    margin-bottom: 20px;
}

.results-defeat {
    color: rgb(210, 80, 80);
    font-size: 40px;
    -unity-font-style: bold;
    margin-bottom: 20px;
}

/* --- Хаб / здания / гача (Фаза 5) --- */

.currency-label {
    font-size: 18px;
    color: rgb(230, 200, 60);
    -unity-font-style: bold;
    margin-bottom: 20px;
}

.buildings-row {
    flex-direction: row;
    justify-content: center;
}

.building-card {
    background-color: rgb(30, 30, 36);
    border-radius: 6px;
    padding: 16px;
    margin: 8px;
    width: 280px;
}

.building-card-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    margin-bottom: 8px;
}

/* --- Выбор персонажа перед забегом (Core Loop 1 п.2 / 7.2) --- */

.character-select-cards-row {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
}

.character-select-card {
    width: 300px;
    min-height: 610px;
    margin: 8px;
    padding: 14px;
    background-color: rgb(30, 30, 36);
    border-width: 1px;
    border-color: rgb(70, 70, 82);
    border-radius: 8px;
    align-items: stretch;
}

.character-select-portrait-frame {
    height: 320px;
    overflow: hidden;
    background-color: rgb(18, 18, 22);
    border-radius: 6px;
    margin-bottom: 10px;
}

.character-select-portrait {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.character-select-class {
    color: rgb(190, 200, 220);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.character-select-stat {
    color: rgb(215, 215, 215);
    font-size: 14px;
    margin-bottom: 3px;
}

.character-select-skill {
    color: rgb(230, 200, 90);
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 6px;
    padding: 4px;
    border-radius: 3px;
}

.character-select-skill:hover {
    color: rgb(255, 230, 120);
    background-color: rgb(48, 48, 58);
}

.character-skill-tooltip {
    position: absolute;
    width: 360px;
    max-width: 420px;
    padding: 12px;
    background-color: rgba(18, 18, 22, 0.97);
    border-width: 1px;
    border-color: rgb(184, 142, 62);
    border-radius: 6px;
}

.character-skill-tooltip-text {
    color: rgb(240, 240, 240);
    font-size: 14px;
    white-space: normal;
}
