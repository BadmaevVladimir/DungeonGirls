  effectDescription: "\u0423\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439
    \u043F\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0439 \u043D\u0430\u0432\u044B\u043A
    \u0414\u0436\u0435\u043D\u0438\u0444\u0435\u0440. \u041D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
    % \u043E\u0442 \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C\u0430 \u0444\u0438\u0437.
    \u0437\u0430\u0449\u0438\u0442\u044B (\u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0441 \u0431\u043E\u043D\u0443\u0441\u043E\u043C \u041A\u0443\u0437\u043D\u0438\u0446\u044B;
    \u043F\u0440\u0438 \u043C\u0430\u043A\u0441. \u0443\u0440. \u043E\u0431\u043E\u0438\u0445
    = \u043F\u043E\u043B\u043D\u043E\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    \u0431\u0440\u043E\u043D\u0438 \u043D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435):
    \u0423\u0440.1=10%, \u0423\u0440.2=20%, \u0423\u0440.3=30%, \u0423\u0440.4=40%,
    \u0423\u0440.5=50%."
