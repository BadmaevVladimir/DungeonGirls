  skillName: "\u0411\u0435\u0440\u0441\u0435\u0440\u043A"
  skillId: 32
  effectDescription: "\u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u0431\u0435\u0437 \u043f\u0435\u0440\u0435\u0437\u0430\u0440\u044f\u0434\u043a\u0438: \u043f\u043e\u043a\u0430 \u0432\u043a\u043b\u044e\u0447\u0451\u043d, \u0433\u0435\u0440\u043e\u0438\u043d\u044f \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043e\u043f\u0440\u043e\u0442\u0438\u0432\u043b\u0435\u043d\u0438\u0435, \u043d\u043e \u043a\u0430\u0436\u0434\u0443\u044e \u0441\u0435\u043a\u0443\u043d\u0434\u0443 \u0442\u0435\u0440\u044f\u0435\u0442 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435. \u041d\u0430\u0432\u044b\u043a \u0441\u0430\u043c \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0441\u0438\u043b\u044c\u043d\u0435\u0435 \u043d\u0430 5-\u043c \u0438 10-\u043c \u0443\u0440\u043e\u0432\u043d\u044f\u0445 \u0433\u0435\u0440\u043e\u0438\u043d\u0438."
