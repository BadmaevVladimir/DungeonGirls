  skillName: "\u0428\u0438\u043F\u044B"
  skillId: 9
  category: 1
  effectDescription: "\u041A\u043E\u0433\u0434\u0430 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0430\u0442\u0430\u043A\u0430 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
    \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u0430
    \u0431\u0440\u043E\u043D\u0451\u0439, \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442
    \u0447\u0430\u0441\u0442\u044C \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
    \u0443\u0440\u043E\u043D\u0430. \u041E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435
    \u043F\u043E \u0443\u0440\u043E\u0432\u043D\u044F\u043C: 1=10%, 2=20%, 3=30%,
    4=40%, 5=50%. \u041F\u043E\u0442\u043E\u043B\u043E\u043A \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u044F
    \u2014 50%. \u041D\u0430 5 \u0443\u0440\u043E\u0432\u043D\u0435 50% \u0432\u0445\u043E\u0434\u044F\u0449\u0435\u0433\u043E
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0443\u0440\u043E\u043D\u0430
    \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F \u0438 \u043F\u0440\u0438
    \u043F\u0440\u043E\u0431\u0438\u0442\u0438\u0438 \u0431\u0440\u043E\u043D\u0438."
  maxLevel: 5
