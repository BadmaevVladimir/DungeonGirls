  skillName: "\u0410\u043C\u0431\u0438\u0434\u0435\u043A\u0441\u0442\u0440\u0438\u044F"
  skillId: 8
  category: 1
  effectDescription: "\u0421\u043D\u0438\u0436\u0430\u0435\u0442 \u0448\u0442\u0440\u0430\u0444
    \u0437\u0430 \u0434\u0432\u043E\u0439\u043D\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435.
    \u0415\u0441\u043B\u0438 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436 \u044D\u043A\u0438\u043F\u0438\u0440\u0443\u0435\u0442
    \u043E\u0440\u0443\u0436\u0438\u0435 \u0432 \u043E\u0431\u0430 \u0441\u043B\u043E\u0442\u0430
    \u0440\u0443\u043A, \u043E\u043D \u0430\u0442\u0430\u043A\u0443\u0435\u0442 \u043E\u0431\u043E\u0438\u043C\u0438
    \u043E\u0440\u0443\u0436\u0438\u044F\u043C\u0438 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E,
    \u043D\u043E \u043A\u0430\u0436\u0434\u043E\u0435 \u0441 \u0441\u043E\u043A\u0440\u0430\u0449\u0451\u043D\u043D\u043E\u0439
    \u0441\u0438\u043B\u043E\u0439. \u0411\u0430\u0437\u043E\u0432\u044B\u0439 \u0448\u0442\u0440\u0430\u0444
    \u0431\u0435\u0437 \u043D\u0430\u0432\u044B\u043A\u0430 = 75% \u0441\u0438\u043B\u044B
    \u0430\u0442\u0430\u043A\u0438 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F.
    \u0423\u0440\u043E\u0432\u043D\u0438 \u043D\u0430\u0432\u044B\u043A\u0430 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442
    \u044D\u0442\u043E\u0442 %: 1\u0443\u0440=90%, 2\u0443\u0440=100%, 3\u0443\u0440=110%,
    4\u0443\u0440=120%, 5\u0443\u0440=130%. \u0420\u0430\u0431\u043E\u0442\u0430\u0435\u0442
    \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0438 \u0434\u0432\u0443\u0445
    \u043E\u0440\u0443\u0436\u0438\u044F\u0445 \u0432 \u0440\u0443\u043A\u0430\u0445
    (\u043D\u0435 \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430 \u0441\u0432\u044F\u0437\u043A\u0443
    \u043E\u0440\u0443\u0436\u0438\u0435+\u0449\u0438\u0442)."
  maxLevel: 5
