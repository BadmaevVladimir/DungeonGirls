  skillName: "\u041A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0435\u043D\u0438\u0435"
  category: 1
  effectDescription: "\u041F\u0440\u0438 \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u0438
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0443\u0440\u043E\u043D\u0430
    \u043F\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044E \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430
    \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0435\u043D\u0438\u0435
    \u043D\u0430 3 \u0441\u0435\u043A\u0443\u043D\u0434\u044B (\u043D\u0435 \u0441\u0442\u0430\u043A\u0430\u0435\u0442\u0441\u044F,
    \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435
    \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u0442 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C):
    1\u0443\u0440=5 \u0443\u0440\u043E\u043D\u0430/\u0441\u0435\u043A, 2\u0443\u0440=10,
    3\u0443\u0440=15, 4\u0443\u0440=20. \u041D\u0430 5 \u0443\u0440\u043E\u0432\u043D\u0435
    \u0443\u0440\u043E\u043D \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F 20/\u0441\u0435\u043A,
    \u043D\u043E \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0439."
