  skillName: "\u0420\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0438\u0435 \u0431\u0440\u043E\u043D\u0438"
  skillId: 13
  category: 3
  effectDescription: "\u041F\u0430\u0441\u0441\u0438\u0432\u043A\u0430 \u0420\u0443\u0431\u0438\u043B\u0430.
    \u041F\u043E\u0441\u043B\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0443\u0440\u043E\u043D\u0430 \u043F\u043E \u0431\u0440\u043E\u043D\u0435 \u0446\u0435\u043B\u0438
    \u0441 \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C\u044E
    25% \u0437\u0430 \u0440\u0430\u043D\u0433 \u044D\u0444\u0444\u0435\u043A\u0442\u0430
    \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u0435\u0451 \u0435\u0449\u0451 \u043D\u0430
    1, \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C 100% \u0438 \u043D\u0435
    \u0431\u043E\u043B\u0435\u0435 1 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0431\u0440\u043E\u043D\u0438 \u0437\u0430 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435.
    \u0420\u0430\u043D\u0433: I \u043D\u0430 \u0443\u0440. \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430
    1\u20133, \u0437\u0430\u0442\u0435\u043C +I \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0435
    3 \u0443\u0440., \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C V."
  maxLevel: 1
