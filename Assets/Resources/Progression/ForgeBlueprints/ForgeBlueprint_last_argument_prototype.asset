  displayName: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442"
  description: "\u041F\u043E\u0437\u0438\u0442\u0438\u0432\u043D\u044B\u0435 \u0431\u043E\u043D\u0443\u0441\u044B
